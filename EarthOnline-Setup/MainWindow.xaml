<Window x:Class="EarthOnline.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="地球Online 安装向导"
        Icon="Assets/app_logo.ico"
        Width="600" Height="560" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 头部 ===== -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="24,16">
                <Image Source="pack://application:,,,/Assets/app_logo.png" Width="40" Height="40" Margin="0,0,14,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="地球Online" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="桌面端安装向导" FontSize="12" Foreground="{StaticResource TextSubBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== 主体（三页切换，整体可滚动） ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0" Focusable="False">
            <Grid MinHeight="380">

                <!-- 选项页 -->
                <Grid x:Name="OptionsGrid" Margin="28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="欢迎安装 地球Online 桌面端"
                                   FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="VersionText" Text="版本 1.0.4"
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="安装位置" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PathBox" Grid.Column="0" VerticalContentAlignment="Center"/>
                                <Button x:Name="BrowseBtn" Grid.Column="1" Content="浏览…"
                                        Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="BrowseBtn_Click"/>
                            </Grid>
                            <TextBlock x:Name="PathHint" Text="选择安装盘符后，将自动创建专属文件夹（如 D:\EarthOnline），不会散落文件。默认安装到用户目录，无需管理员权限。"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Button x:Name="UseProgramFilesBtn" Content="改为安装到 C:\Program Files\EarthOnline（需要管理员权限）"
                                    Style="{StaticResource SoftButton}" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" Click="UseProgramFilesBtn_Click"/>

                            <TextBlock Text="快捷方式" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,20,0,8"/>
                            <CheckBox x:Name="DesktopChk" Content="创建桌面快捷方式"/>
                            <CheckBox x:Name="StartMenuChk" Content="创建开始菜单快捷方式"/>
                            <CheckBox x:Name="TaskbarChk" Content="固定到任务栏（系统限制，可能需手动固定）"/>
                            <TextBlock Text="安装完成后将注册系统卸载入口，可随时在 Windows「设置 → 应用 → 安装的应用」中完全卸载。"
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="InstallBtn" Grid.Column="1" Content="安装"
                                Style="{StaticResource PrimaryButton}" Width="130" Click="InstallBtn_Click"/>
                        <Button x:Name="CancelBtn" Grid.Column="2" Content="取消"
                                Style="{StaticResource SoftButton}" Width="100" Margin="10,0,0,0" Click="CancelBtn_Click"/>
                    </Grid>
                </Grid>

                <!-- 进度页 -->
                <Grid x:Name="ProgressGrid" Visibility="Collapsed" Margin="28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ProgressTitle" Text="正在安装…"
                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <ProgressBar x:Name="ProgressBar" Grid.Row="1" Margin="0,16,0,0"/>
                    <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Margin="0,14,0,0" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText" FontSize="12" Foreground="{StaticResource TextSubBrush}"
                                       TextWrapping="Wrap" FontFamily="Consolas, 'Microsoft YaHei UI'"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 完成页 -->
                <Grid x:Name="DoneGrid" Visibility="Collapsed" Margin="28,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource OkBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontSize="34" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="安装成功！" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="18" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock x:Name="DoneSummary" FontSize="13" Foreground="{StaticResource TextSubBrush}" TextWrapping="Wrap"/>
                            <Border x:Name="TaskbarNote" Background="{StaticResource AmberSoftBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock FontSize="12" Foreground="{StaticResource AccentDarkBrush}" TextWrapping="Wrap">
                                    <Run Text="关于“固定到任务栏”：Windows 限制第三方程序无法静默固定任务栏。请在开始菜单中找到「地球Online」快捷方式，右键 → 更多 → 固定到任务栏 即可。"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RunBtn" Grid.Column="1" Content="立即运行 地球Online"
                                Style="{StaticResource PrimaryButton}" Width="170" Click="RunBtn_Click"/>
                        <Button x:Name="FinishBtn" Grid.Column="2" Content="完成"
                                Style="{StaticResource SoftButton}" Width="100" Margin="10,0,0,0" Click="FinishBtn_Click"/>
                    </Grid>
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
