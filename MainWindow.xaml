<Window x:Class="EarthOnline.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EarthOnline.Desktop"
        mc:Ignorable="d"
        Title="地球Online"
        Width="1180" Height="740"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app_logo.ico"
        Background="{DynamicResource AppBgBrush}"
        SizeChanged="Window_SizeChanged">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <!-- 侧栏宽度由代码按窗口尺寸自适应（200 / 64 图标模式） -->
            <ColumnDefinition x:Name="NavColumn" Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航栏（纳入壁纸覆盖：半透明遮罩垫层，文字可读且不割裂） ============ -->
        <Border Grid.Column="0"
                Background="{DynamicResource NavMaskBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 应用标题 -->
                    <RowDefinition Height="*"/>     <!-- 导航项 -->
                    <RowDefinition Height="Auto"/>  <!-- 底部版本 -->
                </Grid.RowDefinitions>

                <!-- 应用标题 + 收起/展开开关 -->
                <Grid Grid.Row="0" Margin="16,20,12,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <!-- 侧栏收起为图标模式时隐藏文字+logo，避免与收起/展开按钮争夺 64px 宽度导致图标被裁切 -->
                                    <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <!-- 应用 logo：与移动端/任务栏图标同一套资源 -->
                        <Image Source="pack://application:,,,/Assets/app_logo.png"
                               Width="22" Height="22" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="地球Online"
                                   Style="{StaticResource NavTextStyle}"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                    <Button x:Name="ToggleNavBtn" Grid.Column="1"
                            Click="ToggleNavBtn_Click"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Width="28" Height="28" ToolTip="收起/展开侧栏"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="ToggleIcon" Text="⟨" FontSize="16"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <!-- 导航项 -->
                <ListBox x:Name="NavList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         SelectionChanged="NavList_SelectionChanged"
                         SelectedIndex="0">
                    <ListBoxItem Tag="home">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="主页" Style="{StaticResource NavTextStyle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="tasks">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✅" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="任务" Style="{StaticResource NavTextStyle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="backpack">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎒" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="背包" Style="{StaticResource NavTextStyle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="achievements">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏆" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="成就" Style="{StaticResource NavTextStyle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="map">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗺️" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="地图" Style="{StaticResource NavTextStyle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="data">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="数据" Style="{StaticResource NavTextStyle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="report">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗒️" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="报告" Style="{StaticResource NavTextStyle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="ai">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🤖" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="AI 助手" Style="{StaticResource NavTextStyle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                    <!-- 设置统一置于侧栏最底部 -->
                    <ListBoxItem Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Style="{StaticResource NavIconStyle}"/>
                            <TextBlock Text="设置" Style="{StaticResource NavTextStyle}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- 底部版本 -->
                <TextBlock Grid.Row="2"
                           Text="v1.0.3"
                           Style="{StaticResource NavTextStyle}"
                           FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="18,0,12,16"/>
            </Grid>
        </Border>

        <!-- ============ 右侧内容区 ============ -->
        <!-- 内容区文字垫层：半透明遮罩让壁纸透出微光，同时保证页面文字清晰可读 -->
        <Border Grid.Column="1"
                Margin="10"
                CornerRadius="14"
                Background="{DynamicResource ContentScrimBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"/>

        <Frame x:Name="ContentFrame"
               Grid.Column="1"
               Margin="10"
               NavigationUIVisibility="Hidden"
               Background="Transparent"
               JournalOwnership="OwnsJournal"/>

        <!-- 全局同步状态提示条（对齐 Android 全局离线横幅）：非弹窗、置顶、自动消退、可手关 -->
        <Border x:Name="SyncBanner"
                Grid.ColumnSpan="2"
                Panel.ZIndex="50"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0"
                MaxWidth="460"
                Visibility="Collapsed"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,9">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="SyncBannerClose" Click="SyncBannerClose_Click"
                        Content="✕" FontSize="11" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource SoftButtonStyle}"
                        ToolTip="关闭提示"/>
                <TextBlock x:Name="SyncBannerIcon" Text="✅" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="SyncBannerText" Text="" FontSize="13" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
