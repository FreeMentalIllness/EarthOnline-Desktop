<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>EarthOnline.Desktop</RootNamespace>
    <!-- 产物名固定为 EarthOnline.exe（便携版/Release 资产名），与仓库文件名无关 -->
    <AssemblyName>EarthOnline</AssemblyName>
    <!-- 应用图标：与移动端同一套 logo（由安卓 mipmap ic_launcher 生成，16~256 全尺寸） -->
    <ApplicationIcon>Assets\app_logo.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 版本号：UpdateService 以此为当前版本，与 GitHub Releases 的 tag（v1.0.0 格式）比较 -->
    <Version>1.0.1</Version>
    <AssemblyTitle>地球Online 桌面端</AssemblyTitle>
    <Product>地球Online</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- 界面内图标资源：窗口/托盘/标题栏共用（与移动端一致） -->
    <Resource Include="Assets\app_logo.ico" />
    <Resource Include="Assets\app_logo.png" />
    <!-- 地图页：内嵌为资源，运行时释放到数据目录再加载（兼容单文件发布） -->
    <Resource Include="Assets\map.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <!-- MVVM 架构（用户红线要求） -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <!-- 系统托盘（纯 WPF 的 NotifyIcon 实现，不污染 WPF 命名空间） -->
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
