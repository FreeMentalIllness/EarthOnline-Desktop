<Application x:Class="EarthOnline.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EarthOnline.Desktop"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ===== 配色：与网页端 / 安卓端保持一致 ===== -->
        <Color x:Key="AppBgColor">#F8F6F2</Color>
        <Color x:Key="CardBgColor">#FFFFFF</Color>
        <Color x:Key="BorderColor">#E8E2DA</Color>
        <Color x:Key="AccentColor">#D4A373</Color>
        <Color x:Key="TextPrimaryColor">#1E1A16</Color>
        <Color x:Key="TextSecondaryColor">#7A7268</Color>
        <Color x:Key="TextMutedColor">#B0A89C</Color>

        <!-- 代码生成界面（指标卡 / 日历 / 图表 / 气泡 / 芯片）复用的扩展色。
             这些位置无法写 DynamicResource，改由 ThemeService.Brush(key) 在生成时取值，
             主题切换后由设置页触发重绘，效果与 XAML 里的 DynamicResource 一致。 -->
        <Color x:Key="SoftBgColor">#F8F6F2</Color>
        <Color x:Key="ChipFillColor">#EFE9E0</Color>
        <Color x:Key="Heat0Color">#FAF8F5</Color>
        <Color x:Key="Heat1Color">#F5E9DC</Color>
        <Color x:Key="Heat2Color">#EBD3B3</Color>
        <Color x:Key="Heat3Color">#D9B48A</Color>
        <Color x:Key="DueDotColor">#E76F51</Color>
        <Color x:Key="StatusDoneColor">#D4A373</Color>
        <Color x:Key="StatusActiveColor">#8AA79B</Color>
        <Color x:Key="StatusPausedColor">#E3C1A2</Color>
        <Color x:Key="StatusPlanningColor">#C9C2B8</Color>
        <Color x:Key="AiBubbleUserColor">#F3E4D2</Color>
        <Color x:Key="AiBubbleAiColor">#F6F4F0</Color>
        <Color x:Key="ChartGridColor">#E8E2DA</Color>
        <Color x:Key="ChartTextColor">#B0A89C</Color>

        <!-- 主题切换机制（重要，改动前先看）：
             Application.Resources 里的 Freezable 会被框架自动冻结（BAML 加载期就冻结），
             冻结后运行时改 Color 会静默失败 —— 这就是「主题切换看着没反应」的根因。
             因此主题服务改为「整体替换画刷对象」，XAML 侧统一用 DynamicResource 引用画刷
             （见 ThemeService.ApplyTheme）。新增画刷引用时请沿用 DynamicResource，
             改用 StaticResource 会导致该处不随主题更新。 -->
        <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" po:Freeze="False"/>

        <SolidColorBrush x:Key="SoftBgBrush" Color="{StaticResource SoftBgColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="ChipFillBrush" Color="{StaticResource ChipFillColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="Heat0Brush" Color="{StaticResource Heat0Color}" po:Freeze="False"/>
        <SolidColorBrush x:Key="Heat1Brush" Color="{StaticResource Heat1Color}" po:Freeze="False"/>
        <SolidColorBrush x:Key="Heat2Brush" Color="{StaticResource Heat2Color}" po:Freeze="False"/>
        <SolidColorBrush x:Key="Heat3Brush" Color="{StaticResource Heat3Color}" po:Freeze="False"/>
        <SolidColorBrush x:Key="DueDotBrush" Color="{StaticResource DueDotColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="StatusDoneBrush" Color="{StaticResource StatusDoneColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="StatusActiveBrush" Color="{StaticResource StatusActiveColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="StatusPausedBrush" Color="{StaticResource StatusPausedColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="StatusPlanningBrush" Color="{StaticResource StatusPlanningColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="AiBubbleUserBrush" Color="{StaticResource AiBubbleUserColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="AiBubbleAiBrush" Color="{StaticResource AiBubbleAiColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="ChartGridBrush" Color="{StaticResource ChartGridColor}" po:Freeze="False"/>
        <SolidColorBrush x:Key="ChartTextBrush" Color="{StaticResource ChartTextColor}" po:Freeze="False"/>

        <!-- 空字符串转 Collapsed（可选文本） -->
        <local:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>

        <!-- ===== 导航项（ListBoxItem）===== -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFEAE3"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 导航文字：窗口变窄时自动隐藏（仅留图标） -->
        <Style x:Key="NavTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 导航图标 -->
        <Style x:Key="NavIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== 通用卡片 ===== -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 毛玻璃风格卡片：半透明 + 柔和阴影。
             说明：不用 BlurEffect 对背景做真实模糊（逐帧开销大、易卡顿），
             改用半透明白底 + 轻阴影模拟玻璃质感，保证在低端机也跟手流畅。 -->
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#CCFFFFFF"/>
            <Setter Property="BorderBrush" Value="#BFE6E0D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.10" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 页面标题 ===== -->
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="PageSubTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- ===== 分组标题（卡片内小节） ===== -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ===== 分段控件（RadioButton 组） ===== -->
        <Style x:Key="SegButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3EEE8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 指标卡（可点击：悬停轻微放大 + 加深阴影，0.15s 缓出，流畅无卡顿）===== -->
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" Color="#000000"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatNumStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- ===== 主页快速入口按钮（含悬停高亮）===== -->
        <Style x:Key="QuickButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFEAE3"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
