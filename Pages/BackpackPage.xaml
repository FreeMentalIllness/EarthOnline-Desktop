<Page x:Class="EarthOnline.Desktop.Pages.BackpackPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="背包"
      Background="{DynamicResource AppBgBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Grid Margin="24" AllowDrop="True" DragEnter="BackpackPage_DragEnter" Drop="BackpackPage_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
                <TextBlock Text="💡 把电脑上的任意文件拖拽到本窗口，即可复制进本地私有目录并记录到背包"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Border>
            <TextBlock Text="背包" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="物品与收藏（共用自定义分类）" Style="{StaticResource PageSubTitleStyle}"/>
        </StackPanel>

        <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="Tabs_SelectionChanged"
                    Background="Transparent" BorderBrush="{DynamicResource BorderBrush}">
            <!-- 物品 -->
            <TabItem Header="物品">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="⚙️ 分类" Padding="12,6" Click="ManageItemCategories_Click" Cursor="Hand"/>
                            <!-- v1.0.3：分类标签常驻横向滚动，新分类直接出现在按钮右侧 -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Margin="8,0,0,0" MaxWidth="560" VerticalAlignment="Center"
                                          PreviewMouseWheel="ChipScroll_PreviewMouseWheel">
                                <StackPanel x:Name="ItemCategoryChips" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="＋ 新增物品" Padding="12,6" Click="AddItem_Click"
                                    Background="{DynamicResource AccentBrush}" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 搜索框（对标两端：按名称/描述/分类过滤） -->
                    <TextBox x:Name="ItemSearchBox" Grid.Row="1" Height="34" Padding="10,0"
                             VerticalContentAlignment="Center" FontSize="13" Margin="0,0,0,10"
                             TextChanged="ItemSearch_TextChanged"/>
                    <TextBlock x:Name="ItemSearchHint" Grid.Row="1" Text="🔍 搜索物品（名称 / 描述 / 分类）" FontSize="12" Margin="12,0,0,10"
                               IsHitTestVisible="False" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
                        <ListBox x:Name="ItemList" BorderThickness="0" Background="Transparent"
                                 ContextMenuOpening="ItemList_ContextOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✏️ 编辑" Click="EditItem_Click"/>
                                    <MenuItem Header="🗑 删除" Click="DeleteItem_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_RightClick"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <!-- 分类分组头置顶显示：分类名 + 数量（对齐移动端分组语义） -->
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding ItemCount, StringFormat=（{0}）}"
                                                           FontSize="11" Margin="4,1,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" Width="24"/>
                                            <TextBlock Text="{Binding Name}" FontSize="14"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding TypeLabel}" FontSize="11" Margin="8,2,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding CreatedAtLabel}" FontSize="12" Margin="8,2,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <!-- v1.0.3：物品故事卡 —— 描述以 📖 样式强调展示 -->
                                        <TextBlock Margin="26,3,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding HasStory, Converter={StaticResource BoolToVis}}">
                                            <Run Text="📖 " Foreground="{DynamicResource AccentBrush}"/>
                                            <Run Text="{Binding Story, Mode=OneWay}"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 FontStyle="Italic"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 收藏 -->
            <TabItem Header="收藏">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Content="⚙️ 分类" Padding="12,6" Click="ManageCollectionCategories_Click" Cursor="Hand"/>
                            <!-- v1.0.3：分类标签常驻横向滚动，新分类直接出现在按钮右侧 -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Margin="8,0,0,0" MaxWidth="560" VerticalAlignment="Center"
                                          PreviewMouseWheel="ChipScroll_PreviewMouseWheel">
                                <StackPanel x:Name="CollectionCategoryChips" Orientation="Horizontal"/>
                            </ScrollViewer>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="＋ 新增收藏" Padding="12,6" Click="AddCollection_Click"
                                    Background="{DynamicResource AccentBrush}" Foreground="White"
                                    BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 搜索框（标题 / 备注） -->
                    <TextBox x:Name="CollectionSearchBox" Grid.Row="1" Height="34" Padding="10,0"
                             VerticalContentAlignment="Center" FontSize="13" Margin="0,0,0,10"
                             TextChanged="CollectionSearch_TextChanged"/>
                    <TextBlock x:Name="CollectionSearchHint" Grid.Row="1" Text="🔍 搜索收藏（标题 / 备注）" FontSize="12" Margin="12,0,0,10"
                               IsHitTestVisible="False" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
                        <ListBox x:Name="CollectionList" BorderThickness="0" Background="Transparent"
                                 ContextMenuOpening="CollectionList_ContextOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✏️ 编辑" Click="EditCollection_Click"/>
                                    <MenuItem Header="📎 打开附件" Click="OpenCollectionFile_Click"/>
                                    <MenuItem Header="🗑 删除" Click="DeleteCollection_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="ListBoxItem_RightClick"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <!-- 分类分组头置顶显示：分类名 + 数量 -->
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding ItemCount, StringFormat=（{0}）}"
                                                           FontSize="11" Margin="4,1,0,0"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="📚" Width="24"/>
                                        <TextBlock Text="{Binding Title}" FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding FileLabel}" FontSize="12" Margin="8,2,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding CreatedAtLabel}" FontSize="12" Margin="8,2,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
