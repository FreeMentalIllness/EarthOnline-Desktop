<Page x:Class="EarthOnline.Desktop.Pages.OnboardingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="欢迎"
      Background="{DynamicResource AppBgBrush}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 步骤指示 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="Dot1" Text="① 欢迎" FontSize="12" Margin="6,0"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock x:Name="Dot2" Text="② 功能" FontSize="12" Margin="6,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock x:Name="Dot3" Text="③ 同步" FontSize="12" Margin="6,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
            <TextBlock x:Name="Dot4" Text="④ 数据" FontSize="12" Margin="6,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- ===== 步骤 1：欢迎 + 创建角色 ===== -->
                    <StackPanel x:Name="Step1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/app_logo.png"
                                   Width="64" Height="64" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="欢迎来到地球Online" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="把人生当游戏来玩：任务即主线，习惯即成就。"
                                           FontSize="13" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="先建个角色（可留空，之后在设置里随时改）" FontSize="13"
                                   Margin="0,24,0,10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Grid MaxWidth="420" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="昵称" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="生日" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="BirthBox" Grid.Row="1" Grid.Column="1" Padding="8,6" Margin="0,4"
                                     ToolTip="格式 YYYY-MM-DD，决定等级 Lv（周岁），可留空"/>
                        </Grid>
                    </StackPanel>

                    <!-- ===== 步骤 2：核心功能简介 ===== -->
                    <StackPanel x:Name="Step2" Visibility="Collapsed">
                        <TextBlock Text="你能在这里做什么" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <UniformGrid Columns="2" Margin="0,18,0,0" MaxWidth="620" HorizontalAlignment="Center">
                            <TextBlock Text="📋 任务树：主线 / 习惯 / 清单，带进度与明细" FontSize="13" Margin="0,8"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="🎒 背包与收藏：物品、文件、链接分类管理" FontSize="13" Margin="0,8"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="🏆 成就与彩蛋：28 项自动解锁 + 自定义成就" FontSize="13" Margin="0,8"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="🗺️ 足迹地图：高德地图标记去过的地方" FontSize="13" Margin="0,8"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="📊 数据看板与报告：日报 / 周报 / 年报" FontSize="13" Margin="0,8"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="🤖 AI 助手：接入自己的接口，基于你的数据聊天" FontSize="13" Margin="0,8"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </UniformGrid>
                        <TextBlock Text="快捷键：Ctrl + 1~9 切换页面，Ctrl + S 保存 / 推送。"
                                   FontSize="12" Margin="0,16,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <!-- ===== 步骤 3：WebDAV 同步引导 ===== -->
                    <StackPanel x:Name="Step3" Visibility="Collapsed">
                        <TextBlock Text="三端数据同步（可选）" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="填一次 WebDAV，桌面 / 安卓 / 网页就能共用同一份数据；现在不配也行，之后在设置页随时配。"
                                   FontSize="12" Margin="0,8,0,16" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="520"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Grid MaxWidth="460" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="服务器" FontSize="13"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="UrlBox" Grid.Row="0" Grid.Column="1" Padding="8,6" Margin="0,4"
                                     ToolTip="例如 https://dav.jianguoyun.com/dav/"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="用户名" FontSize="13"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox x:Name="UserBox" Grid.Row="1" Grid.Column="1" Padding="8,6" Margin="0,4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="密码" FontSize="13"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <PasswordBox x:Name="PassBox" Grid.Row="2" Grid.Column="1" Padding="8,6" Margin="0,4"
                                         ToolTip="坚果云等需用「应用密码」而非登录密码"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Content="测试连接" Padding="14,6" Click="TestConn_Click" Cursor="Hand"/>
                            <TextBlock x:Name="SyncTipText" Margin="12,0,0,0" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== 步骤 4：数据导入 / 导出 ===== -->
                    <StackPanel x:Name="Step4" Visibility="Collapsed">
                        <TextBlock Text="带上你的旧数据（可选）" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="如果你在网页端 / 安卓端已经攒过数据，可直接导入备份；也可以先空手开始，之后在设置页随时导入。"
                                   FontSize="12" Margin="0,8,0,18" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="520"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="导入备份文件…" Padding="14,8" Click="Import_Click" Cursor="Hand"
                                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                            <Button Content="导出一份备份…" Padding="14,8" Margin="10,0,0,0"
                                    Click="Export_Click" Cursor="Hand"/>
                            <Button Content="从云端恢复…" Padding="14,8" Margin="10,0,0,0"
                                    Click="Pull_Click" Cursor="Hand"/>
                        </StackPanel>

                        <TextBlock x:Name="DataTipText" Margin="0,18,0,0" FontSize="12" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="全部数据只存在你自己的电脑里；唯一的网络出口是你自己配置的 WebDAV。"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- 底部按钮 -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="SkipBtn" Content="跳过引导" Padding="14,7" DockPanel.Dock="Left"
                    Click="Skip_Click" Cursor="Hand"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button x:Name="PrevBtn" Content="上一步" Padding="14,7" Click="Prev_Click" Cursor="Hand"/>
                <Button x:Name="NextBtn" Content="下一步" Padding="18,7" Margin="10,0,0,0"
                        Click="Next_Click" Background="{DynamicResource AccentBrush}" Foreground="White"
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Page>
