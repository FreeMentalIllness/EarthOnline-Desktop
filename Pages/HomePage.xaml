<Page x:Class="EarthOnline.Desktop.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="主页"
      Background="Transparent">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="1040">
            <!-- ===== 顶部问候区（对齐移动端信息架构：问候语即页面标题） ===== -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SeasonBadge}" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>
                <TextBlock Text="主页" FontSize="22" FontWeight="SemiBold" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
            <TextBlock Text="{Binding GreetingText}" FontSize="13" Margin="2,0,0,16"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- ============ 个人资料卡 ============ -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 头像：自定义图片优先（圆形裁剪），否则 emoji 预设（复用安卓 avatarKey） -->
                    <Border Grid.Column="0" Width="76" Height="76" CornerRadius="38"
                            Background="{DynamicResource ChipFillBrush}"
                            Margin="0,0,20,0">
                        <Grid>
                            <TextBlock Text="{Binding AvatarEmoji}" FontSize="36"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatarImage}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Image Source="{Binding AvatarImage}" Width="76" Height="76"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVis}}">
                                <Image.Clip>
                                    <EllipseGeometry Center="38,38" RadiusX="38" RadiusY="38"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <!-- v1.0.3：称号 · Lv.X（称号存 settings.json，等级=周岁） -->
                            <TextBlock Text="{Binding TitleLine}" FontSize="15" FontWeight="SemiBold"
                                       Margin="10,2,0,0" VerticalAlignment="Center"
                                       Foreground="#B08045"/>
                            <!-- 等级徽章（Lv 数据与称号行同口径，悬浮可见天数明细） -->
                            <Border Background="{DynamicResource SoftBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="7,2" Margin="10,2,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding DaysLivedText}"
                                    Visibility="{Binding HasLevel, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LevelStatText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#B08045"/>
                            </Border>
                        </StackPanel>
                        <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0">
                            <Run Text="{Binding BirthDate}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding Gender}"/>
                            <Run Text="{Binding DaysLivedText}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Signature}" FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Signature, Converter={StaticResource EmptyToCollapsed}}"/>
                        <!-- 经验条：距下一个生日的进度（网页口径） -->
                        <StackPanel Margin="0,8,0,0"
                                    Visibility="{Binding HasLevel, Converter={StaticResource EmptyToCollapsed}}">
                            <ProgressBar Height="8" Minimum="0" Maximum="100"
                                         Value="{Binding LevelProgress, Mode=OneWay}"
                                         BorderThickness="0" Background="{DynamicResource SoftBgBrush}"
                                         Foreground="#D4A373"/>
                            <TextBlock Text="{Binding LevelSubText}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <!-- 自定义字段 chips -->
                        <ItemsControl ItemsSource="{Binding CustomFields}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ChipFillBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="8,3" Margin="0,4,6,0">
                                        <TextBlock Text="{Binding}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 编辑资料 -->
                    <Button Style="{StaticResource SoftButtonStyle}" Grid.Column="2" Content="✏️ 编辑资料" Padding="12,6"
                            VerticalAlignment="Top" Click="EditProfile_Click" Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- ============ 概览：模块入口行（点击直达对应页面） ============ -->
            <TextBlock Text="概览" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,8"/>
            <UniformGrid Columns="4" Margin="0,0,0,4">
                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,8,0"
                        Tag="tasks" Cursor="Hand" MouseLeftButtonUp="StatCard_Click" ToolTip="点击进入任务">
                    <StackPanel>
                        <TextBlock Text="🗂" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TaskCount}" Style="{StaticResource StatNumStyle}"/>
                        <TextBlock Text="任务" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}" Margin="4,0,4,0"
                        Tag="backpack" Cursor="Hand" MouseLeftButtonUp="StatCard_Click" ToolTip="点击进入背包">
                    <StackPanel>
                        <TextBlock Text="🎒" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ItemCount}" Style="{StaticResource StatNumStyle}"/>
                        <TextBlock Text="背包" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCardStyle}" Margin="4,0,4,0"
                        Tag="achievements" Cursor="Hand" MouseLeftButtonUp="StatCard_Click" ToolTip="点击进入成就">
                    <StackPanel>
                        <TextBlock Text="🏆" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AchievementCount}" Style="{StaticResource StatNumStyle}"/>
                        <TextBlock Text="成就" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>
                <!-- 数据 ↔ 足迹换位：足迹上模块行（导航入口），数据单独成宽卡放下一行 -->
                <Border Style="{StaticResource StatCardStyle}" Margin="8,0,0,0"
                        Tag="map" Cursor="Hand" MouseLeftButtonUp="StatCard_Click" ToolTip="点击进入足迹地图">
                    <StackPanel>
                        <TextBlock Text="🗺" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding FootprintCount}" Style="{StaticResource StatNumStyle}"/>
                        <TextBlock Text="足迹" Style="{StaticResource StatLabelStyle}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ============ 概览：数据宽卡（完成率摘要，等级 / 灵感速览已按需求移除） ============ -->
            <Border x:Name="OverviewDataCard" Style="{StaticResource StatCardStyle}" Margin="0,8,0,4"
                    Tag="data" Cursor="Hand" MouseLeftButtonUp="StatCard_Click" ToolTip="点击进入数据看板">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DoneRateText}" FontSize="22" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="完成率" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="任务 / 背包 / 成就 / 日志汇总" FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="进入数据看板 →" FontSize="12" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
            </Border>


            <!-- ============ 今日速览（连续记录 / 今日一签 / 徽章墙 合并卡，置于概览下方） ============ -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Visibility="{Binding HasStreakCard, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🌱 连续记录" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding StreakText}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Visibility="{Binding StreakText, Converter={StaticResource EmptyToCollapsed}}"/>
                            <TextBlock Text="{Binding ComebackText}" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding ComebackText, Converter={StaticResource EmptyToCollapsed}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Visibility="{Binding HasDailyPick, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="🎴 今日一签" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding DailyPickText}" FontSize="13" LineHeight="20" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DailyPickSub}" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10"/>

                    <DockPanel>
                        <Button Style="{StaticResource SoftButtonStyle}" DockPanel.Dock="Right" Content="佩戴徽章" Padding="12,5"
                                Click="PickBadges_Click" Cursor="Hand"/>
                        <TextBlock Text="🎖 徽章墙" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Badges}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ChipFillBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="10,5" Margin="0,2,8,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🏆" FontSize="14" VerticalAlignment="Center"/>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding SubText}" FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="还没有佩戴徽章：点「佩戴徽章」，把解锁的成就别在胸口 ✨" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="2,6,0,0"
                               Visibility="{Binding NoBadges, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- ============ 历年今日（独立卡，点击翻开旧时光） ============ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12"
                    Visibility="{Binding HasThisDay, Converter={StaticResource BoolToVis}}"
                    Cursor="Hand" MouseLeftButtonUp="ThisDay_Click"
                    ToolTip="点击翻开这一年的旧时光">
                <StackPanel>
                    <TextBlock Text="🕰️ 历年今日" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{Binding ThisDayText}" FontSize="13" LineHeight="21"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="✦ 点击卡片翻看旧时光" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <!-- ============ 人生卡 ============ -->
            <Border Style="{StaticResource CardStyle}"
                    Visibility="{Binding LifeCardText, Converter={StaticResource EmptyToCollapsed}}">
                <StackPanel>
                    <TextBlock Text="🌱 人生卡" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{Binding LifeCardText}" FontSize="13" LineHeight="22"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource SoftButtonStyle}" Content="📷 分享人生卡" Padding="12,5"
                                Click="ShareCard_Click" Cursor="Hand"
                                ToolTip="把等级 / 连续记录 / 本月节奏生成长图，保存为 PNG"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 最近动态 ============ -->
            <TextBlock Text="⏱ 最近动态" Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,8"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding RecentActivities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="2,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11"
                                                   Margin="8,2,0,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="还没有动态：完成任务、写日志、解锁成就都会出现在这里 ✨" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="2,10,0,0"
                               Visibility="{Binding NoActivities, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- ============ 世界日志 ============ -->
            <TextBlock Text="🌍 世界日志" Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,8"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- 类型统一标签行（随笔 / 重要 / 灵感 / 心情，四选一并列） -->
                    <WrapPanel x:Name="MemoTypeRow">
                        <Button Content="📝 随笔" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="type:note" Click="MemoTag_Click"/>
                        <Button Content="❗ 重要" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="type:important" Click="MemoTag_Click"/>
                        <Button Content="💡 灵感" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="type:idea" Click="MemoTag_Click"/>
                        <Button Content="🎭 心情" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="mood-open" Click="MemoTag_Click"/>
                    </WrapPanel>
                    <!-- 心情快选行：选「心情」后展开（8 种心情并入该选项，不再单独平铺） -->
                    <WrapPanel x:Name="MoodRow" Visibility="Collapsed">
                        <Button Content="😄 开心" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="mood:😄 开心" Click="MemoTag_Click"/>
                        <Button Content="😌 平静" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="mood:😌 平静" Click="MemoTag_Click"/>
                        <Button Content="🥱 疲惫" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="mood:🥱 疲惫" Click="MemoTag_Click"/>
                        <Button Content="😤 上头" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="mood:😤 上头" Click="MemoTag_Click"/>
                        <Button Content="😢 难过" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="mood:😢 难过" Click="MemoTag_Click"/>
                        <Button Content="🤯 爆炸" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="mood:🤯 爆炸" Click="MemoTag_Click"/>
                        <Button Content="🥳 庆祝" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="mood:🥳 庆祝" Click="MemoTag_Click"/>
                        <Button Content="😴 摆烂" Style="{StaticResource QuickButtonStyle}" Padding="10,5" Margin="0,0,6,6" Tag="mood:😴 摆烂" Click="MemoTag_Click"/>
                    </WrapPanel>

                    <DockPanel Margin="0,2,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}" DockPanel.Dock="Right" Content="记录" Padding="14,0" Height="34"
                                Margin="8,0,0,0" Click="MemoSave_Click" Cursor="Hand"/>
                        <TextBox x:Name="MemoBox" Height="34" VerticalContentAlignment="Center"
                                 Padding="10,0" FontSize="13"
                                 Background="{DynamicResource SoftBgBrush}"
                                 KeyDown="MemoBox_KeyDown"/>
                    </DockPanel>
                    <TextBlock Text="选一个标签定类型；点「心情」展开快选，未输入文字时选心情即一键记录（回车同样生效）"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="2,6,0,0"/>

                    <!-- 最近 5 条 -->
                    <ItemsControl ItemsSource="{Binding RecentMemos}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                        Padding="2,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TypeEmoji}" FontSize="13" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11"
                                                   Margin="8,2,0,0" VerticalAlignment="Top"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                        <Button Style="{StaticResource SoftButtonStyle}" Grid.Column="3" Content="🗑" FontSize="12" Margin="8,0,0,0"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" Click="MemoDelete_Click" Tag="{Binding Id}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="还什么都没有，写下第一条日志吧 ✨" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="2,10,0,0"
                               Visibility="{Binding NoMemos, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>

            <!-- ============ 提示：概览卡片均可点击进入对应模块 ============ -->
            <TextBlock Text="💡 上方概览卡片均可点击，直接进入对应模块"
                       Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,8"/>
        </StackPanel>
    </ScrollViewer>
</Page>
