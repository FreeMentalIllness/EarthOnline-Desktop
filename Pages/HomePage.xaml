<Page x:Class="EarthOnline.Desktop.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="主页"
      Background="{StaticResource AppBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="主页" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="地球Online · 桌面端骨架已就绪" Style="{StaticResource PageSubTitleStyle}"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="个人信息" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SummaryText"
                               Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="加载中…"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="统计概览" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <UniformGrid Columns="3" Margin="0,12,0,0">
                        <Border Background="{StaticResource AppBgBrush}" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="TaskCountText" Text="-" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="任务总数" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AppBgBrush}" CornerRadius="8" Padding="12" Margin="4,0">
                            <StackPanel>
                                <TextBlock x:Name="ItemCountText" Text="-" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="背包物品" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AppBgBrush}" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="MemoCountText" Text="-" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="世界日志" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
