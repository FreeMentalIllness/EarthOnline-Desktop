<Page x:Class="EarthOnline.Desktop.Pages.AchievementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="成就"
      Background="{DynamicResource AppBgBrush}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="成就" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Name="SummaryText" Text="自动成就与自定义成就" Style="{StaticResource PageSubTitleStyle}"/>
        </StackPanel>

        <!-- ============ 总览卡：进度环 + 仅看未解锁 ============ -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Grid Width="76" Height="76">
                        <Canvas x:Name="OverviewRing"/>
                        <TextBlock x:Name="RingText" Text="0%" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock x:Name="OverviewText" Text="已解锁 0 / 0" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="OverviewSub" Text="" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <CheckBox x:Name="OnlyUnlocked" Content="仅看未解锁" VerticalAlignment="Center"
                          DockPanel.Dock="Right" FontSize="13"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          Checked="OnlyUnlocked_Changed" Unchecked="OnlyUnlocked_Changed"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ComboBox x:Name="CategoryFilter" Width="130" Padding="8" SelectedIndex="0"
                              SelectionChanged="CategoryFilter_SelectionChanged">
                        <ComboBoxItem Content="全部分类" Tag=""/>
                        <ComboBoxItem Content="📋 任务" Tag="task"/>
                        <ComboBoxItem Content="🎒 背包" Tag="bag"/>
                        <ComboBoxItem Content="📚 收藏" Tag="collection"/>
                        <ComboBoxItem Content="🗺️ 足迹" Tag="map"/>
                        <ComboBoxItem Content="📝 日志" Tag="memo"/>
                        <ComboBoxItem Content="🌱 成长" Tag="growth"/>
                        <ComboBoxItem Content="🏅 综合" Tag="general"/>
                        <ComboBoxItem Content="🥚 彩蛋" Tag="egg"/>
                        <ComboBoxItem Content="✍️ 自定义" Tag="custom"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="重新判定" Padding="12,6" Click="Refresh_Click" Cursor="Hand"/>
                    <Button Content="＋ 自定义成就" Padding="12,6" Margin="6,0,0,0" Click="AddCustom_Click"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="删除" Padding="12,6" Margin="6,0,0,0" Click="DeleteCustom_Click" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="8">
            <ListBox x:Name="AchList" BorderThickness="0" Background="Transparent">
                <!-- 按分类分组为可展开分区（Expander），头显示分类名 + 已解锁 x/y -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True" Margin="0,2">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding ItemCount, StringFormat=（{0} 条）}"
                                                                   FontSize="11" Margin="6,1,0,0"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter/>
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="18" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding DisplayDesc}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <!-- current/goal 进度条（仅自动成就且未解锁时显示） -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                        Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="6"
                                             BorderThickness="0" Background="#F5E9DC" Foreground="#D4A373"/>
                                <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="0,3,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="12"
                                       VerticalAlignment="Center" Margin="12,0,8,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Page>
